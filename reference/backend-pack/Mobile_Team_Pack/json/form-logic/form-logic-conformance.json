{
  "about": "Every operator and function of the catalogue run on one sample. Load form-logic-host-shim.js and form-logic.bundle.js, then ConnectumFormLogic.runConformance(this object): `failures` must be empty.",
  "sample": {
    "fields": {
      "name": "  Asha Rao ",
      "phone": "9876543210",
      "email": "asha@example.com",
      "city": "Pune",
      "code": "AB-12",
      "note": "",
      "age": 17,
      "qty": 3,
      "price": 250,
      "amount": 1234567.5,
      "joined": "2026-04-03",
      "ends": "2026-04-30"
    },
    "rows": {
      "lineitem": [
        "Bolt",
        "Nut",
        "Bolt"
      ],
      "lineqty": [
        2,
        3,
        1
      ],
      "linerate": [
        10,
        5,
        40
      ]
    }
  },
  "cases": [
    {
      "expr": "qty*price",
      "expect": "750"
    },
    {
      "expr": "qty%2",
      "expect": "1"
    },
    {
      "expr": "2^3",
      "expect": "8"
    },
    {
      "expr": "city=\"Pune\"",
      "expect": "true"
    },
    {
      "expr": "city!=\"Goa\"",
      "expect": "true"
    },
    {
      "expr": "age>=18",
      "expect": "false"
    },
    {
      "expr": "age>=18 && qty>0",
      "expect": "false"
    },
    {
      "expr": "age>=18 || qty>0",
      "expect": "true"
    },
    {
      "expr": "(qty+1)*price",
      "expect": "1000"
    },
    {
      "expr": "IIF(age>=18,\"Adult\",\"Minor\")",
      "expect": "Minor"
    },
    {
      "expr": "IsEmpty(Trim(\"  \"))",
      "expect": "T"
    },
    {
      "expr": "CheckEmail(email)",
      "expect": "true"
    },
    {
      "expr": "ChkUniqChar(\"AABC\")",
      "expect": "true"
    },
    {
      "expr": "IsOperator(\"+\")",
      "expect": "true"
    },
    {
      "expr": "Length(phone)",
      "expect": "10"
    },
    {
      "expr": "SubStr(phone,1,2)",
      "expect": "98"
    },
    {
      "expr": "Upper(city)",
      "expect": "PUNE"
    },
    {
      "expr": "Lower(city)",
      "expect": "pune"

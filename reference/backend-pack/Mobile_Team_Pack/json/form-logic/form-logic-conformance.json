    {
      "expr": "Length(Trim(name))",
      "expect": "8"
    },
    {
      "expr": "TrimInBetwnSpaces(name)",
      "expect": "AshaRao"
    },
    {
      "expr": "Str(qty)",
      "expect": "3"
    },
    {
      "expr": "Val(\"1,250.50\")",
      "expect": "1250.5"
    },
    {
      "expr": "ExtractNum(code)",
      "expect": "12"
